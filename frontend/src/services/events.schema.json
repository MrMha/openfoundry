    "AgentThoughtEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "mission_id": {
          "format": "uuid",
          "title": "Mission Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "type": {
          "const": "agent_thought",
          "default": "agent_thought",
          "title": "Type",
          "type": "string"
        },
        "department": {
          "anyOf": [
            {
              "$ref": "#/$defs/Department"
            },
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            }
          ],
          "title": "Department"
        },
        "task_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "thought": {
          "maxLength": 32768,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Thought",
          "type": "string"
        },
        "level": {
          "default": "info",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "mission_id",
        "department",
        "thought"
      ],
      "title": "AgentThoughtEvent",
      "type": "object"
    },
